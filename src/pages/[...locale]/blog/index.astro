---
import { Debug } from "astro:components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import { i18nGetStaticPaths } from "@i18n/ui";
import { siteConfig } from "@config/site";
import { getBlogPosts } from "@utils/blog";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPostItem from "@components/BlogPostItem.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = i18nGetStaticPaths;

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const blogPageTwoUrl = getRelativeLocaleUrl(locale, "/blog/page/2");

const locales = ["en", "cy", "fr", "se", "pl", "de"];
const defaultLocale = "en";

// get all posts, sorted by date
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// group them by their filename (strip the locale part)
const grouped = Object.groupBy(posts, (post) =>
  post.id.split("/").slice(1).join("/")
);

// prefer a locale specific post over the 'default' english one
const localizedPosts = Object.values(grouped)
  .map((variants) => {
    if (!variants) return null;

    return (
      variants.find((post) => post.id.startsWith(`${locale}/`)) ??
      variants.find((post) => post.id.startsWith("en/"))
    );
  })
  .filter((post): post is CollectionEntry<"blog"> => post !== undefined)
  .filter(Boolean);

const pageTitle = t("blog.heading");
const morePages =
  Math.ceil(localizedPosts.length / siteConfig.blog.postsPerPage) > 1;
const postsToShow = localizedPosts.slice(0, siteConfig.blog.postsPerPage);
---

<BaseLayout pageTitle={pageTitle} mainClass="blog-index-main">
  <div class="container">
    <header class="page-heading">
      <h1>{pageTitle}</h1>
    </header>
  </div>

  <section>
    <div class="container">
      {
        postsToShow.length > 0 ? (
          <ul class="blog-post-list">
            {postsToShow.map((post) => (
              <BlogPostItem post={post} />
            ))}
          </ul>
        ) : (
          <p>No posts</p>
        )
      }
      {
        morePages && (
          <nav class="pagination blog-pagination">
            <a href={blogPageTwoUrl} class="button blog-older-posts">
              {t("blog.olderPosts")} &rarr;
            </a>
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
