---
import { Debug } from "astro:components";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@i18n/utils";
import type { Lang } from "@i18n/ui";
import { i18nGetStaticPaths } from "@i18n/ui";
import { siteConfig } from "@config/site";
import { getLocalisedBlogPosts } from "@utils/blog";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogPostItem from "@components/BlogPostItem.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = i18nGetStaticPaths;

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const pageTitle = t("blog.heading");

const localisedPosts = await getLocalisedBlogPosts(locale);

const postsToShow = localisedPosts.slice(0, siteConfig.blog.postsPerPage);

const morePages = localisedPosts.length > siteConfig.blog.postsPerPage;

const blogPageTwoUrl = getRelativeLocaleUrl(locale, "/blog/page/2");
---

<BaseLayout pageTitle={pageTitle} mainClass="blog-index-main">
  <div class="container">
    <header class="page-heading">
      <h1>{pageTitle}</h1>
    </header>
  </div>

  <section>
    <div class="container">
      {
        postsToShow.length > 0 ? (
          <ul class="blog-post-list">
            {postsToShow.map((post) => (
              <BlogPostItem post={post} />
            ))}
          </ul>
        ) : (
          <p>No posts</p>
        )
      }
      {
        morePages && (
          <nav class="pagination blog-pagination">
            <a href={blogPageTwoUrl} class="button blog-older-posts">
              {t("blog.olderPosts")} &rarr;
            </a>
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
